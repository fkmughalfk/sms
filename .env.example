# apps/api  (copy to apps/api/.env)
# On Vercel, the Neon integration sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct, used for migrations).
# Local dev without Neon: run `pnpm --filter api db:local` and use the URL below.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable"
DATABASE_POOL_MAX=1                                 # local PGlite serves one connection; omit on Neon
# DIRECT_URL="postgresql://..."                     # optional: direct URL for migrations (else DATABASE_URL_UNPOOLED / DATABASE_URL)
JWT_ACCESS_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"                                # refresh tokens are opaque, hashed in the DB — no secret needed
PORT=4000
WEB_URL="http://localhost:3000"
SEED_SUPERADMIN_EMAIL="admin@example.com"
SEED_SUPERADMIN_PASSWORD="ChangeMe123!"
# Optional: `pnpm db:seed` also loads the old Excel workbook (paths from the repo root; data/ is git-ignored)
# SEED_WORKBOOK="data/Sales Management System.xlsx"
# SEED_MAPPING="data/mapping.json"                 # Sheet1 party/bank decisions (see README → Importing)

# apps/web  (copy to apps/web/.env.local)
API_URL="http://localhost:4000"
