    "test": "vitest run"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sms/eslint-config": "workspace:*",
    "@sms/tsconfig": "workspace:*",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
